# ============================================================================
# S.M.I.P — environment configuration
# Copy to .env and fill in. NEVER commit the real .env (already gitignored).
# ============================================================================

# --- AI provider ------------------------------------------------------------
# The app talks to one OpenAI-compatible chat-completions gateway.
# Default: Sakelar (https://app.sakelar.web.id) — one key, every model.
AI_API_KEY=""
AI_BASE_URL="https://api.sakelar.web.id/v1"
AI_MODEL="glm-5.3-flash"
# "openai" (default, /chat/completions) or "anthropic" (/messages)
AI_FORMAT="openai"

# --- Server ---
# Port the Express server binds to (most PaaS providers inject this).
PORT="3000"
# "production" enables optimised static serving and disables the Vite middleware.
NODE_ENV="development"
# debug | info | warn | error | silent
LOG_LEVEL="info"
# Comma-separated allowlist; leave empty to serve same-origin only.
CORS_ORIGINS=""
# Set to "false" only if the app is NOT behind a reverse proxy / load balancer.
TRUST_PROXY="1"

# --- Public URL (used for self-referential links and OAuth callbacks) ---
APP_URL="http://localhost:3000"

# --- API authentication -----------------------------------------------------
# When set, every POST/PUT/PATCH/DELETE under /api requires
# "Authorization: Bearer <token>". GET routes stay public for dashboards.
# REQUIRED for any deployment exposed beyond localhost.
API_AUTH_TOKEN=""

# --- Data honesty -----------------------------------------------------------
# There is no simulation mode: every figure comes from a real source. Configure
# at least one source below or the dashboard will stay empty by design.
INGEST_INTERVAL_MS="120000"

# --- Data sources -----------------------------------------------------------
# Open collectors need nothing here: Reddit, Mastodon, Bluesky, Hacker News,
# Google News, Lemmy, Stack Overflow, GitHub (anonymous) and DEV Community are
# queried directly through their public endpoints.
YOUTUBE_API_KEY=""
TWITTER_BEARER_TOKEN=""
# Optional: lifts GitHub's anonymous rate limit.
GITHUB_TOKEN=""
# Twitch needs an app pair (client-credentials flow).
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- Firebase / Firestore sync (optional) -----------------------------------
# Provide EITHER a full service account JSON, OR the individual fields below.
# Without these the app runs fully on the local SQLite cache.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
