# ============================================================================
# S.M.I.P — environment configuration
# Copy to .env and fill in. NEVER commit the real .env (already gitignored).
# ============================================================================
#
# THIS FILE IS THE ONLY WAY TO SET A KEY.
# The app has no settings screen and no key field, by design. Every secret
# below is read from process.env at call time, and the API rejects any
# POST/PUT/PATCH under /api that carries a secret-named field with
#   400 { "reason": "credentials-not-accepted" }
# To rotate a key: edit .env on the server, then restart the process.
# ============================================================================

# --- AI provider ------------------------------------------------------------
# The app talks to one OpenAI-compatible chat-completions gateway.
# Default: Sakelar (https://app.sakelar.web.id) — one key, every model.
#
# This key buys three things and nothing else:
#   1. sentiment / emotion analysis of a post you submit;
#   2. the three-day forecast from mentions you already collected;
#   3. the wording of AI-written summaries.
# On its own this key does NOT buy web search: the gateway exposes
# /chat/completions only. Channels with no public read API (TikTok, Instagram,
# Facebook, ...) need BOTH this key and a search provider below.
AI_API_KEY=""
AI_BASE_URL="https://api.sakelar.web.id/v1"
AI_MODEL="glm-5.3-flash"
# "openai" (default, /chat/completions) or "anthropic" (/messages)
AI_FORMAT="openai"

# --- Web search -------------------------------------------------------------
# Feeds the channels that have no public read API. Two free options:
#
#   searxng  host it yourself. No key, no quota, no cost. Best for a VPS.
#            docker run -d -p 8080:8080 searxng/searxng
#            then set SEARXNG_URL and add "json" to search.formats in its
#            settings.yml, otherwise the API refuses JSON requests.
#   tavily   1,000 credits per month free, no credit card. Basic search = 1
#            credit. Use SEARCH_API_KEY from tavily.com.
#
# Leave both empty and the search-only channels simply collect nothing; the
# sources dialog says so per channel. No simulated rows either way.
SEARCH_PROVIDER=""        # searxng | tavily | none
SEARXNG_URL=""            # e.g. http://127.0.0.1:8080
SEARCH_API_KEY=""         # Tavily only
# "en" (default) or "id". Also switches Google News to hl=id&gl=ID, so an
# Indonesian tracker gets Indonesian coverage instead of English coverage of an
# Indonesian brand. Search results are filtered to the last week.
SEARCH_LANGUAGE=""

# --- Server ---
# Port the Express server binds to (most PaaS providers inject this).
PORT="3000"
# "production" enables optimised static serving and disables the Vite middleware.
NODE_ENV="development"
# debug | info | warn | error | silent
LOG_LEVEL="info"
# Comma-separated allowlist; leave empty to serve same-origin only.
CORS_ORIGINS=""
# Set to "false" only if the app is NOT behind a reverse proxy / load balancer.
TRUST_PROXY="1"

# --- Public URL (used for self-referential links and OAuth callbacks) ---
APP_URL="http://localhost:3000"

# --- API authentication -----------------------------------------------------
# When set, every POST/PUT/PATCH/DELETE under /api requires either
#   - a dashboard session (visit /, sign in with this token once), or
#   - "Authorization: Bearer <token>" for scripts and uptime checks.
# GET routes stay public. The dashboard itself also requires the session, so an
# anonymous visitor lands on the sign-in page instead of an empty shell.
# REQUIRED for any deployment exposed beyond localhost.
# The token is never shipped in the browser bundle; the session cookie holds a
# one-way HMAC of it, so rotating the token logs every session out.
API_AUTH_TOKEN=""

# --- Data honesty -----------------------------------------------------------
# There is no simulation mode: every figure comes from a real source. Configure
# at least one source below or the dashboard will stay empty by design.
INGEST_INTERVAL_MS="120000"

# --- Data sources -----------------------------------------------------------
# These need NOTHING here. They are queried through documented public endpoints
# and collect real rows with no key, no card and no quota:
#   Bluesky, Mastodon (hashtag timelines), Hacker News (stories + comments),
#   Google News, Lemmy, Stack Overflow, GitHub (anonymous), DEV Community,
#   YouTube (RSS discovery), Reddit (anonymous search), Medium (tag RSS).
# Everything below is optional and only deepens a channel that already works.

# YouTube: discovery uses the public RSS feed. The key adds real view counts via
# videos.list (1 quota unit per 50 videos) and is NOT used for search.list, which
# costs 100 units of a 10,000/day budget.
YOUTUBE_API_KEY=""

# X / Twitter: API v2 recent search. Free tier is limited but the call is valid;
# without it the channel collects nothing (search cannot read X posts).
TWITTER_BEARER_TOKEN=""

# Optional: lifts GitHub's anonymous rate limit (60 -> 5,000 requests/hour).
GITHUB_TOKEN=""

# Reddit: anonymous search.json works but is rate limited to 403 from many hosts.
# A free "script" app at reddit.com/prefs/apps makes it reliable.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Mastodon: comma-separated instances to read public hashtag timelines from.
MASTODON_INSTANCES=""     # default mastodon.social,mastodon.online,fosstodon.org

# Twitch: free app pair (client-credentials). Collects live channels matching the
# keyword; the open API does not expose chat.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- Database: Supabase -----------------------------------------------------
# Supabase is the only storage. There is no local database file.
#
# 1. Create a project at https://supabase.com
# 2. SQL Editor -> paste supabase/schema.sql -> Run   (creates the tables + RLS)
# 3. Project Settings -> API:
#      Project URL          -> SUPABASE_URL
#      service_role secret  -> SUPABASE_SERVICE_ROLE_KEY
#
# The service-role key bypasses Row Level Security, so it must only ever live on
# the server (never in the browser bundle). Without these two variables the API
# still starts, but every read returns empty data and /api/health reports
# "not-configured" — it never invents rows.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: a publishable/anon key. Not used by the server; kept here so the
# distinction is explicit. RLS grants it nothing.
SUPABASE_ANON_KEY=""
