rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny by default. S.M.I.P reads and writes Firestore exclusively through the
    // Firebase Admin SDK on the server (which bypasses these rules), so no client
    // access is needed at all.
    //
    // Previous state was `allow read, write: if true` on every collection, which
    // combined with a public Web API key meant anyone on the internet could read,
    // modify, or wipe this database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
